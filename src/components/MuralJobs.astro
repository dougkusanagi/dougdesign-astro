---
import { getCollection } from 'astro:content';
import JobCard from './JobCard.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const jobs = await getCollection('jobs', ({ data }) => data.active !== false);
const sortedJobs = jobs.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<section id="vagas" class="wrap mt-20 scroll-mt-28 sm:mt-28" aria-labelledby="vagas-title">
  <div class="panel p-5 sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <SectionHeading id="vagas-title" eyebrow="Oportunidades" title="Mural de vagas e serviços" />
        <p class="mt-2 max-w-xl text-sm text-ink-3">Encontre profissionais ou divulgue uma oportunidade de design, programação ou UI/UX.</p>
      </div>
      <button
        data-tally-open="b5gMJe"
        data-tally-emoji-text="👋"
        data-tally-emoji-animation="wave"
        class="btn btn-primary shrink-0 self-start"
      >
        Anunciar oportunidade
      </button>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {sortedJobs.length > 0 ? (
        sortedJobs.map((job) => (
          <JobCard
            title={job.data.title}
            company={job.data.company}
            description={job.data.description}
            type={job.data.type}
            salary={job.data.salary}
            pubDate={job.data.pubDate}
            link={job.data.link}
          />
        ))
      ) : (
        <div class="col-span-full flex flex-col items-center justify-between gap-6 rounded-2xl border border-dashed border-line-strong bg-canvas p-6 md:flex-row md:p-8">
          <div class="max-w-2xl text-center md:text-left">
            <span class="badge-beta"><Icon name="briefcase" class="mr-1 h-3 w-3" /> Espaço para recrutadores</span>
            <h3 class="mt-3 font-display text-xl font-extrabold leading-snug text-ink">Quer contratar talentos de tecnologia e design?</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-2">Anuncie suas oportunidades na home e alcance desenvolvedores, designers, editores de vídeo e especialistas em IA que leem o blog.</p>
          </div>
          <button data-tally-open="b5gMJe" data-tally-emoji-text="👋" data-tally-emoji-animation="wave" class="btn btn-primary shrink-0">
            Divulgar vaga <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </div>
      )}
    </div>
  </div>
</section>
