---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** "brand" = faixa azul de marca (categorias); "plain" = cabeçalho calmo. */
  tone?: 'plain' | 'brand';
  class?: string;
}

const { title, eyebrow, description, tone = 'plain', class: className = '' } = Astro.props;
---

{tone === 'brand' ? (
  <section class:list={['relative isolate overflow-hidden bg-brand-600 text-white', className]}>
    <div class="absolute inset-0 -z-10" style="background: radial-gradient(90% 120% at 100% 0%, #3b8dff 0%, rgba(59,141,255,0) 60%), linear-gradient(160deg, #0866fa 0%, #0a4fd0 60%, #0a3a9e 100%);"></div>
    <span class="brand-d" style="right:-5rem;top:-5rem;width:22rem;height:22rem;background:rgb(255 255 255 / 0.08);border-radius:999px;"></span>
    <span class="brand-square" style="right:14rem;bottom:-2rem;width:6rem;height:6rem;background:rgb(255 255 255 / 0.1);"></span>
    <div class="wrap relative py-12 sm:py-16">
      {eyebrow && <p class="eyebrow !text-white">{eyebrow}</p>}
      <h1 class="mt-2 font-display text-[clamp(2.25rem,6vw,4rem)] font-extrabold leading-[1.02] tracking-[-0.03em]">{title}</h1>
      {description && <p class="mt-4 max-w-xl text-base leading-relaxed text-white sm:text-lg">{description}</p>}
      <div class="mt-6 empty:hidden"><slot /></div>
    </div>
  </section>
) : (
  <section class:list={['wrap pb-2 pt-10 sm:pt-14', className]}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h-display mt-2 text-[clamp(2rem,5vw,3.25rem)]">{title}</h1>
    {description && <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-3 sm:text-lg">{description}</p>}
    <div class="mt-5 empty:hidden"><slot /></div>
  </section>
)}
