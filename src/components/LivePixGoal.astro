---
import Icon from './Icon.astro';
import { getLivePixGoal, LIVEPIX_PROFILE_URL } from '../lib/livepix';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const goal = await getLivePixGoal();
---

<div data-livepix-goal class:list={['relative rounded-xl border border-line bg-surface-2 p-4 transition-colors hover:border-line-strong', className]}>
  {goal?.message && <p data-lp-message class="text-sm font-semibold text-ink">{goal.message}</p>}
  {
    goal && (
      <div class="mt-3">
        <div
          data-lp-bar
          class="h-2.5 overflow-hidden rounded-full bg-line"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={goal.percent}
          aria-label={`Meta de contribuição: ${goal.percent}% alcançado`}
        >
          <div data-lp-fill class="h-full rounded-full bg-accent transition-[width] duration-500" style={`width: ${Math.max(goal.percent, 3)}%`}></div>
        </div>
        <p class="mt-2 flex items-baseline justify-between gap-2 text-xs text-ink-3">
          <span><strong data-lp-current class="font-bold text-ink">{goal.current}</strong> de <span data-lp-goal>{goal.goal}</span></span>
          <span data-lp-percent class="font-semibold text-accent-strong">{goal.percent}%</span>
        </p>
      </div>
    )
  }
  <a
    href={LIVEPIX_PROFILE_URL}
    target="_blank"
    rel="noopener noreferrer"
    class:list={['btn btn-primary w-full after:absolute after:inset-0 after:content-[\'\']', goal ? 'mt-4' : '']}
  >
    <Icon name="heart" class="h-4 w-4" /> Contribuir no LivePix
  </a>
</div>

<script is:inline>
  (() => {
    if (window.__dougLivePixGoal) return;
    window.__dougLivePixGoal = true;
    // Atualiza a meta ao vivo; se a rota falhar, ficam os valores do build.
    const refresh = () => {
      const cards = document.querySelectorAll('[data-livepix-goal]');
      if (!cards.length) return;
      fetch('/api/livepix/', { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((d) => {
          if (typeof d.percent !== 'number') return;
          cards.forEach((card) => {
            const set = (sel, v) => { const el = card.querySelector(sel); if (el && v) el.textContent = v; };
            set('[data-lp-current]', d.current);
            set('[data-lp-goal]', d.goal);
            set('[data-lp-percent]', `${d.percent}%`);
            const fill = card.querySelector('[data-lp-fill]');
            if (fill) fill.style.width = `${Math.max(d.percent, 3)}%`;
            const bar = card.querySelector('[data-lp-bar]');
            if (bar) { bar.setAttribute('aria-valuenow', String(d.percent)); bar.setAttribute('aria-label', `Meta de contribuição: ${d.percent}% alcançado`); }
          });
        })
        .catch(() => {});
    };
    refresh();
    document.addEventListener('astro:page-load', refresh);
  })();
</script>
