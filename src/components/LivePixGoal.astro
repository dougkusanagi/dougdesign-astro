---
import Icon from './Icon.astro';
import { getLivePixGoal, LIVEPIX_PROFILE_URL } from '../lib/livepix';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const goal = await getLivePixGoal();
---

<div class:list={['rounded-xl border border-line bg-surface-2 p-4', className]}>
  {goal?.message && <p class="text-sm font-semibold text-ink">{goal.message}</p>}
  {
    goal && (
      <div class="mt-3">
        <div
          class="h-2.5 overflow-hidden rounded-full bg-line"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={goal.percent}
          aria-label={`Meta de contribuição: ${goal.percent}% alcançado`}
        >
          <div class="h-full rounded-full bg-accent" style={`width: ${Math.max(goal.percent, 3)}%`}></div>
        </div>
        <p class="mt-2 flex items-baseline justify-between gap-2 text-xs text-ink-3">
          <span><strong class="font-bold text-ink">{goal.current}</strong> de {goal.goal}</span>
          <span class="font-semibold text-accent-strong">{goal.percent}%</span>
        </p>
      </div>
    )
  }
  <a
    href={LIVEPIX_PROFILE_URL}
    target="_blank"
    rel="noopener noreferrer"
    class:list={['btn btn-primary w-full', goal ? 'mt-4' : '']}
  >
    <Icon name="heart" class="h-4 w-4" /> Contribuir no LivePix
  </a>
</div>
