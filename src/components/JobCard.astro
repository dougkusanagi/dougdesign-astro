---
import Icon from './Icon.astro';
import { formatPostDate } from '../lib/nav';

interface Props {
  title: string;
  company: string;
  description: string;
  type: 'Remoto' | 'Freelance' | 'Fixo' | 'Híbrido';
  salary: string;
  pubDate: Date;
  link?: string;
}

const {
  title,
  company,
  description,
  type,
  salary,
  pubDate,
  link = `mailto:contato@dougdesign.com.br?subject=Candidatura: ${encodeURIComponent(title)}`,
} = Astro.props;

const typeTone = {
  Remoto: 'bg-accent-soft text-accent-strong',
  Freelance: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
  Fixo: 'bg-violet-100 text-violet-800 dark:bg-violet-950 dark:text-violet-300',
  Híbrido: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
};
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-line bg-canvas p-5 transition-colors hover:border-accent">
  <div>
    <div class="flex items-center gap-2">
      <span class:list={['rounded-full px-2.5 py-0.5 font-display text-[0.6875rem] font-bold', typeTone[type]]}>{type}</span>
      <time class="text-xs text-ink-3" datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
    </div>
    <h3 class="mt-3 font-display text-base font-bold leading-snug text-ink">{title}</h3>
    <p class="mt-0.5 text-xs font-semibold text-ink-3">{company}</p>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-2">{description}</p>
  </div>
  <div class="mt-5 flex items-center justify-between border-t border-line pt-3 text-sm font-semibold">
    <span class="text-ink">{salary}</span>
    <a href={link} class="stretched inline-flex items-center gap-0.5 text-accent hover:underline">
      Candidatar <Icon name="chevron-right" class="h-4 w-4" />
    </a>
  </div>
</article>
