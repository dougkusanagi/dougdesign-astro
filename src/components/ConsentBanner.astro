<div
  id="consent-banner"
  class="panel fixed inset-x-3 bottom-3 z-[70] hidden max-w-xl p-4 shadow-pop sm:inset-x-auto sm:bottom-5 sm:left-5 sm:p-5"
  role="region"
  aria-label="Preferências de cookies"
>
  <p class="font-display text-base font-extrabold text-ink">Sua privacidade, sua escolha</p>
  <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-2 sm:text-sm">
    O Google tag começa com armazenamento desativado e pode enviar uma medição agregada sem cookies. Analytics completo, anúncios e widgets externos só são ativados quando você autorizar.
    Veja a <a href="/privacidade/" class="font-semibold text-accent underline underline-offset-2">Política de Privacidade</a>.
  </p>

  <details class="group mt-2.5 text-[0.8125rem] sm:text-sm">
    <summary class="cursor-pointer list-none font-semibold text-accent underline-offset-2 hover:underline">Comentários (Giscus)</summary>
    <p class="mt-2 leading-relaxed text-ink-2">Escolha se permite os comentários do GitHub (Giscus), que podem armazenar cookies.</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <button id="consent-comments-accept" type="button" class="btn btn-outline !min-h-9 !px-3 !text-xs">Permitir comentários</button>
      <button id="consent-comments-reject" type="button" class="btn btn-outline !min-h-9 !px-3 !text-xs">Sem comentários</button>
    </div>
  </details>

  <div class="mt-4 flex flex-wrap gap-2">
    <button id="consent-accept" type="button" class="btn btn-primary !min-h-10 flex-1 sm:flex-none">Aceitar tudo</button>
    <button id="consent-reject" type="button" class="btn btn-outline !min-h-10 flex-1 sm:flex-none">Recusar tudo</button>
  </div>
</div>

<script is:inline>
  (function() {
    var CONSENT_KEY = 'dougdesign-consent-v1';
    var CONSENT_ANALYTICS_KEY = 'dougdesign-analytics-consent-v1';
    var CONSENT_ADS_KEY = 'dougdesign-ads-consent-v1';
    var CONSENT_COMMENTS_KEY = 'dougdesign-comments-consent-v1';

    var setupConsentBanner = function() {
      var banner = document.getElementById('consent-banner');
      var acceptButton = document.getElementById('consent-accept');
      var rejectButton = document.getElementById('consent-reject');
      var commentsAcceptButton = document.getElementById('consent-comments-accept');
      var commentsRejectButton = document.getElementById('consent-comments-reject');
      var preferencesButton = document.getElementById('consent-open-preferences');

      if (!banner) return;

      var syncVisibility = function() {
        var current = localStorage.getItem(CONSENT_KEY);
        var commentsCurrent = localStorage.getItem(CONSENT_COMMENTS_KEY);
        
        // Update banner visibility based on main consent
        var preferencesOpen = banner.dataset.preferencesOpen === 'true';
        banner.classList.toggle('hidden', !preferencesOpen && (current === 'accepted' || current === 'rejected'));
        
        // Store comment-specific consent preference
        if (commentsCurrent !== null) {
          localStorage.setItem(CONSENT_COMMENTS_KEY, commentsCurrent);
        }
      };

      if (acceptButton) {
        acceptButton.onclick = function() {
          localStorage.setItem(CONSENT_KEY, 'accepted');
          localStorage.setItem(CONSENT_ANALYTICS_KEY, 'accepted');
          localStorage.setItem(CONSENT_ADS_KEY, 'accepted');
          localStorage.setItem(CONSENT_COMMENTS_KEY, 'comments-accepted');
          banner.dataset.preferencesOpen = 'false';
          syncVisibility();
          document.dispatchEvent(new CustomEvent('doug:consent-granted'));
        };
      }

      if (rejectButton) {
        rejectButton.onclick = function() {
          localStorage.setItem(CONSENT_KEY, 'rejected');
          localStorage.setItem(CONSENT_ANALYTICS_KEY, 'rejected');
          localStorage.setItem(CONSENT_ADS_KEY, 'rejected');
          localStorage.setItem(CONSENT_COMMENTS_KEY, 'comments-rejected');
          banner.dataset.preferencesOpen = 'false';
          syncVisibility();
          document.dispatchEvent(new CustomEvent('doug:consent-denied'));
        };
      }

      if (commentsAcceptButton) {
        commentsAcceptButton.onclick = function() {
          localStorage.setItem(CONSENT_COMMENTS_KEY, 'comments-accepted');
          syncVisibility();
        };
      }

      if (commentsRejectButton) {
        commentsRejectButton.onclick = function() {
          localStorage.setItem(CONSENT_COMMENTS_KEY, 'comments-rejected');
          syncVisibility();
        };
      }

      if (preferencesButton && preferencesButton.dataset.bound !== 'true') {
        preferencesButton.dataset.bound = 'true';
        preferencesButton.onclick = function() {
          banner.dataset.preferencesOpen = 'true';
          banner.classList.remove('hidden');
        };
      }

      syncVisibility();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupConsentBanner, { once: true });
    } else {
      setupConsentBanner();
    }

    document.addEventListener('astro:page-load', setupConsentBanner);
  })();
</script>
