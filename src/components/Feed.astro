---
import { getPublishedPosts } from '../lib/blog';
import PostCard from './PostCard.astro';
import Newsletter from './Newsletter.astro';
import AdSense from './AdSense.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

// Os 5 primeiros já aparecem no bloco de destaques.
const feedPosts = (await getPublishedPosts()).slice(5, 15);
---

<div class="min-w-0 lg:col-span-8">
  <SectionHeading id="feed-title" eyebrow="Fique por dentro" title="Últimas publicações" href="/posts/" linkLabel="Ver todas" />

  <div class="mt-6">
    {feedPosts.map((post, index) => (
      <>
        <PostCard post={post} variant="row" />

        {index === 2 && (
          <AdSense
            slot="7975185751"
            format="fluid"
            layoutKey="-fb+5w+4e-db+86"
            style="display:block"
            size="infeed"
            class="border-b border-line py-6"
            simulatedText="Google AdSense - Bloco In-feed"
          />
        )}
        {index === 5 && (
          <div class="border-b border-line py-8">
            <Newsletter />
          </div>
        )}
        {index === 8 && (
          <AdSense
            slot="8098120205"
            format="auto"
            fullWidthResponsive={true}
            size="rectangle"
            class="border-b border-line py-6"
            simulatedText="AdSense - Meio do Feed"
          />
        )}
      </>
    ))}
  </div>

  <div class="mt-10 text-center">
    <a href="/posts/" class="btn btn-ink !min-h-12 !px-7">
      Ver todas as publicações <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</div>
