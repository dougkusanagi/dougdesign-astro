---
import { getPublishedPosts, getPostSlug } from '../lib/blog';
import PostCard from './PostCard.astro';
import SectionHeading from './SectionHeading.astro';

// Curadoria editorial: a ordem abaixo é a ordem de exibição.
const PICK_IDS = ['design-system-figma-avancado', 'codigo-limpo-typescript-2026', 'revolucao-npus-laptops-hibridos'];

const posts = await getPublishedPosts();
const picks = PICK_IDS.map((id) => posts.find((post) => post.id === id || getPostSlug(post) === id)).filter(
  (post): post is NonNullable<typeof post> => Boolean(post),
);
---

{picks.length > 0 && (
  <section class="wrap mt-16 sm:mt-24" aria-labelledby="picks-title">
    <SectionHeading id="picks-title" eyebrow="Curadoria" title="Escolhas do Doug" />
    <div class="snap-row mt-6 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:m-0 md:p-0">
      {picks.map((post) => (
        <div class="w-[78vw] max-w-sm md:w-auto md:max-w-none">
          <PostCard post={post} variant="card" />
        </div>
      ))}
    </div>
  </section>
)}
