---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SponsorDialog from './SponsorDialog.astro';
import { getCategoryStats, formatPostDate } from '../lib/nav';
import { getPublishedPosts, getPostUrl } from '../lib/blog';

const stats = await getCategoryStats();
const [latest] = await getPublishedPosts();
const primarySlugs = ['games', 'tecnologia', 'inteligencia-artificial', 'programacao', 'web-design'];
const primary = primarySlugs
  .map((slug) => stats.find((category) => category.slug === slug))
  .filter((category): category is NonNullable<typeof category> => Boolean(category));

const pathname = Astro.url.pathname;
const isCurrent = (slug: string) => pathname.startsWith(`/category/${slug}/`);
---

<div id="site-header-wrap" class="site-header-wrap sticky top-0 z-50">
  <header class="relative z-[2] border-b border-line bg-canvas/90 backdrop-blur-md">
    <div class="wrap flex h-16 items-center gap-3 lg:gap-5">
      <a href="/" class="shrink-0 text-ink">
        <Logo />
      </a>

      <!-- Navegação principal (desktop) -->
      <nav class="ml-2 hidden items-center gap-1 lg:flex" aria-label="Principal">
        <button
          type="button"
          class="btn btn-primary mega-trigger group !min-h-9 !gap-1.5 !px-4"
          data-mega-toggle
          aria-expanded="false"
          aria-controls="mega"
        >
          <span data-icon-open><Icon name="menu" class="h-4 w-4" /></span>
          <span data-icon-close class="hidden"><Icon name="x" class="h-4 w-4" /></span>
          Explorar
          <Icon name="chevron-down" class="h-4 w-4 transition-transform duration-300 group-aria-expanded:rotate-180" />
        </button>
        {primary.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            aria-current={isCurrent(category.slug) ? 'page' : undefined}
            class="relative rounded-full px-3 py-2 font-display text-sm font-semibold text-ink-2 transition-colors hover:text-accent aria-[current=page]:text-accent"
          >
            {category.short}
          </a>
        ))}
      </nav>

      <div class="ml-auto flex items-center gap-1">
        <a
          href="/posts/?search=focus"
          data-search-open
          class="hidden h-10 items-center gap-2 rounded-full border border-line bg-surface px-3.5 text-sm text-ink-3 transition-colors hover:border-accent hover:text-ink xl:inline-flex"
          aria-label="Buscar artigos"
        >
          <Icon name="search" class="h-4 w-4" />
          <span class="pr-6">Buscar artigos</span>
          <kbd class="rounded-md border border-line bg-surface-2 px-1.5 py-0.5 font-sans text-[0.6875rem] font-semibold text-ink-3">Ctrl K</kbd>
        </a>
        <a href="/posts/?search=focus" data-search-open class="icon-btn xl:hidden" aria-label="Buscar no site">
          <Icon name="search" class="h-5 w-5" />
        </a>

        <button id="theme-toggle" type="button" class="icon-btn" aria-label="Alternar tema claro e escuro">
          <Icon id="theme-icon-light" name="sun" class="hidden h-5 w-5" />
          <Icon id="theme-icon-dark" name="moon" class="h-5 w-5" />
        </button>

        <a href="/#sponsor" data-sponsor-open class="btn btn-ink ml-1 hidden !min-h-9 !px-4 sm:inline-flex">
          <Icon name="heart" class="h-4 w-4" /> Apoiar
        </a>

        <button
          type="button"
          class="icon-btn lg:hidden"
          data-mega-toggle
          aria-expanded="false"
          aria-controls="mega"
          aria-label="Abrir menu de navegação"
        >
          <span data-icon-open><Icon name="menu" class="h-6 w-6" /></span>
          <span data-icon-close class="hidden"><Icon name="x" class="h-6 w-6" /></span>
        </button>
      </div>
    </div>
  </header>

  <div class="mega-scrim" data-mega-scrim></div>

  <!-- Mega menu: painel azul de marca -->
  <div id="mega" class="mega" data-open="false" role="region" aria-label="Explorar o site">
    <!-- Formas do logotipo como assinatura visual -->
    <span class="brand-d hidden lg:block" style="right:-6rem;top:-4rem;width:22rem;height:22rem;background:rgb(255 255 255 / 0.07);border-radius:999px;"></span>
    <span class="brand-square hidden lg:block" style="right:16rem;bottom:2.5rem;width:5rem;height:5rem;background:rgb(255 255 255 / 0.09);"></span>

    <div class="wrap relative grid gap-10 pb-10 pt-28 lg:grid-cols-12 lg:pb-12 lg:pt-10">
      <nav class="lg:col-span-5" aria-label="Categorias">
        <p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.16em] text-white" data-stagger style="--i:0">Explore por tema</p>
        {stats.map((category, index) => (
          <a
            href={`/category/${category.slug}/`}
            class="mega-cat"
            data-mega-cat={category.slug}
            data-active={index === 0 ? 'true' : 'false'}
            data-stagger
            style={`--i:${index + 1}`}
          >
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <span class="name">{category.label}</span>
            <span class="count">{category.count}</span>
            <Icon name="arrow-right" class="arrow h-5 w-5" />
          </a>
        ))}
      </nav>

      <div class="hidden lg:col-span-4 lg:block" data-stagger style="--i:3">
        {stats.map((category, index) => (
          <div class="mega-preview" data-mega-preview={category.slug} data-active={index === 0 ? 'true' : 'false'}>
            <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-white">Recentes em {category.label}</p>
            <p class="mt-2 max-w-xs text-sm text-white">{category.blurb}</p>
            <ul class="mt-6 space-y-5">
              {category.latest.map((post) => (
                <li>
                  <a href={getPostUrl(post)} class="group block">
                    <span class="block font-display text-[1.0625rem] font-bold leading-snug underline-offset-4 group-hover:underline">{post.data.title}</span>
                    <span class="mt-1 block text-xs font-semibold text-white">{formatPostDate(post.data.pubDate)}{post.data.readingTime ? ` · ${post.data.readingTime}` : ''}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/category/${category.slug}/`} class="mt-7 inline-flex items-center gap-2 font-display text-sm font-bold underline-offset-4 hover:underline">
              Ver os {category.count} artigos <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>

      <aside class="lg:col-span-3" data-stagger style="--i:5" aria-label="Atalhos">
        {latest && (
          <a href={getPostUrl(latest)} class="group block rounded-2xl bg-white/10 p-5 ring-1 ring-white/20 transition-colors hover:bg-white/15">
            <span class="font-display text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-white">Acabou de sair</span>
            <span class="mt-2 block font-display text-lg font-extrabold leading-snug">{latest.data.title}</span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold">Ler agora <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
          </a>
        )}
        <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 font-display text-sm font-bold lg:grid-cols-1">
          <li><a class="inline-flex items-center gap-2 py-1 underline-offset-4 hover:underline" href="/posts/"><Icon name="list" class="h-4 w-4 text-white" /> Todas as publicações</a></li>
          <li><a class="inline-flex items-center gap-2 py-1 underline-offset-4 hover:underline" href="/#vagas"><Icon name="briefcase" class="h-4 w-4 text-white" /> Mural de vagas</a></li>
          <li><a class="inline-flex items-center gap-2 py-1 underline-offset-4 hover:underline" href="/contato/"><Icon name="mail" class="h-4 w-4 text-white" /> Contato</a></li>
          <li><a class="inline-flex items-center gap-2 py-1 underline-offset-4 hover:underline" href="/rss.xml"><Icon name="rss" class="h-4 w-4 text-white" /> Feed RSS</a></li>
        </ul>
        <a href="/#sponsor" data-sponsor-open class="btn btn-white mt-6 w-full sm:hidden">
          <Icon name="heart" class="h-4 w-4" /> Apoiar o Doug Design
        </a>
      </aside>
    </div>
  </div>
</div>

<!-- Busca instantânea (índice carregado só na primeira abertura) -->
<dialog id="search-dialog" class="sheet" aria-label="Buscar no site" data-labels={JSON.stringify(Object.fromEntries(stats.map((category) => [category.slug, category.label])))}>
  <div class="grid min-h-full items-start justify-items-center p-3 pt-[6vh] sm:p-6 sm:pt-[10vh]" data-dialog-backdrop>
    <div class="sheet-card panel w-full max-w-2xl overflow-hidden shadow-pop">
      <form id="search-form" role="search" action="/posts/" method="get" class="flex items-center gap-3 border-b border-line px-4">
        <Icon name="search" class="h-5 w-5 shrink-0 text-ink-3" />
        <input
          id="search-input"
          type="search"
          name="q"
          autocomplete="off"
          spellcheck="false"
          placeholder="Buscar por assunto, jogo ou tecnologia…"
          aria-label="Buscar artigos"
          aria-controls="search-results"
          class="h-14 min-w-0 flex-1 bg-transparent text-base text-ink placeholder:text-ink-3 focus:outline-none"
        />
        <button type="button" data-search-close class="rounded-lg border border-line px-2 py-1 text-[0.6875rem] font-bold text-ink-3 hover:text-ink" aria-label="Fechar busca">ESC</button>
      </form>

      <div id="search-empty" class="p-5">
        <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-ink-3">Comece por um tema</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {stats.map((category) => (
            <a href={`/category/${category.slug}/`} class="chip" data-cat={category.slug}><span class="cat !text-[0.8125rem] !normal-case !tracking-normal !font-semibold">{category.label}</span></a>
          ))}
        </div>
      </div>

      <ul id="search-results" role="listbox" class="hidden max-h-[60vh] overflow-y-auto p-2"></ul>
      <p id="search-status" class="hidden px-5 py-8 text-center text-sm text-ink-3" aria-live="polite"></p>
    </div>
  </div>
</dialog>

<SponsorDialog />

<script>
  type SearchItem = { title: string; slug: string; description: string; category: string; pubDate: string };

  const desktop = window.matchMedia('(min-width: 1024px)');
  const norm = (value: string) =>
    value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const catSlug = (value: string) => norm(value).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector);

  /* ---------- Mega menu ---------- */
  const isMegaOpen = () => $('#mega')?.getAttribute('data-open') === 'true';

  function setMega(open: boolean, restoreFocus = false) {
    const mega = $('#mega');
    if (!mega) return;
    mega.setAttribute('data-open', String(open));
    document.querySelectorAll<HTMLElement>('[data-mega-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      if (toggle.classList.contains('icon-btn')) {
        toggle.setAttribute('aria-label', open ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
      }
    });
    document.getElementById('site-header-wrap')?.toggleAttribute('data-mega-open', open);
    if (open) {
      document.getElementById('site-header-wrap')?.removeAttribute('data-hidden');
    }
    // No celular o painel ocupa a tela: trava a rolagem do fundo.
    document.documentElement.style.overflow = open && !desktop.matches ? 'hidden' : '';
    if (!open && restoreFocus) {
      const toggle = document.querySelector<HTMLElement>(
        desktop.matches ? '.mega-trigger' : '.icon-btn[data-mega-toggle]',
      );
      toggle?.focus();
    }
  }

  function activatePreview(slug: string) {
    document.querySelectorAll('[data-mega-cat]').forEach((el) => {
      el.setAttribute('data-active', String(el.getAttribute('data-mega-cat') === slug));
    });
    document.querySelectorAll('[data-mega-preview]').forEach((el) => {
      el.setAttribute('data-active', String(el.getAttribute('data-mega-preview') === slug));
    });
  }

  /* ---------- Tema ---------- */
  function syncThemeIcons() {
    const dark = document.documentElement.classList.contains('dark');
    document.getElementById('theme-icon-light')?.classList.toggle('hidden', !dark);
    document.getElementById('theme-icon-dark')?.classList.toggle('hidden', dark);
  }

  /* ---------- Busca ---------- */
  let indexPromise: Promise<SearchItem[]> | null = null;
  let activeIndex = -1;

  const loadIndex = () => {
    indexPromise ??= fetch('/search-index.json')
      .then((response) => response.json() as Promise<SearchItem[]>)
      .catch(() => {
        indexPromise = null;
        return [] as SearchItem[];
      });
    return indexPromise;
  };

  const searchDialog = () => document.getElementById('search-dialog') as HTMLDialogElement | null;
  const categoryLabel = (slug: string, fallback: string) => {
    try {
      const labels = JSON.parse(searchDialog()?.dataset.labels || '{}') as Record<string, string>;
      return labels[slug] || fallback;
    } catch {
      return fallback;
    }
  };

  function openSearch() {
    const dialog = searchDialog();
    if (!dialog || dialog.open) return;
    setMega(false);
    dialog.showModal();
    ($('#search-input') as HTMLInputElement | null)?.focus();
    void loadIndex();
  }

  /* ---------- Apoiar ---------- */
  const sponsorDialog = () => document.getElementById('sponsor-dialog') as HTMLDialogElement | null;

  function openSponsor() {
    const dialog = sponsorDialog();
    if (!dialog || dialog.open) return false;
    setMega(false);
    const frame = dialog.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (frame && !frame.src) frame.src = frame.dataset.src as string;
    dialog.showModal();
    return true;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string);
  }

  async function runSearch(rawQuery: string) {
    const results = $('#search-results') as HTMLElement;
    const empty = $('#search-empty') as HTMLElement;
    const status = $('#search-status') as HTMLElement;
    const query = norm(rawQuery.trim());
    activeIndex = -1;

    if (query.length < 2) {
      results.classList.add('hidden');
      status.classList.add('hidden');
      empty.classList.remove('hidden');
      results.innerHTML = '';
      return;
    }

    const tokens = query.split(/\s+/).filter(Boolean);
    const index = await loadIndex();
    if (norm(($('#search-input') as HTMLInputElement).value.trim()) !== query) return;

    const scored = index
      .map((item) => {
        const title = norm(item.title);
        const rest = norm(`${item.category} ${item.description}`);
        let score = 0;
        for (const token of tokens) {
          if (title.includes(token)) score += title.startsWith(token) ? 6 : 4;
          else if (rest.includes(token)) score += 1;
          else return { item, score: 0 };
        }
        return { item, score };
      })
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score || +new Date(b.item.pubDate) - +new Date(a.item.pubDate))
      .slice(0, 8);

    empty.classList.add('hidden');
    if (!scored.length) {
      results.classList.add('hidden');
      results.innerHTML = '';
      status.textContent = `Nenhum artigo encontrado para “${rawQuery.trim()}”.`;
      status.classList.remove('hidden');
      return;
    }

    status.classList.add('hidden');
    results.classList.remove('hidden');
    results.innerHTML = scored
      .map(({ item }) => {
        const slug = catSlug(item.category);
        return `<li role="none"><a role="option" href="/${escapeHtml(item.slug)}/" class="block rounded-xl px-3 py-2.5 transition-colors hover:bg-surface-2 aria-selected:bg-surface-2" data-cat="${slug}">
          <span class="cat">${escapeHtml(categoryLabel(slug, item.category))}</span>
          <span class="mt-0.5 block font-display text-[0.9375rem] font-bold leading-snug text-ink">${escapeHtml(item.title)}</span>
        </a></li>`;
      })
      .join('');
  }

  function moveActive(delta: number) {
    const options = Array.from(document.querySelectorAll<HTMLElement>('#search-results a'));
    if (!options.length) return;
    activeIndex = (activeIndex + delta + options.length) % options.length;
    options.forEach((option, i) => {
      option.setAttribute('aria-selected', String(i === activeIndex));
      if (i === activeIndex) option.scrollIntoView({ block: 'nearest' });
    });
  }

  /* ---------- Eventos (delegados: sobrevivem a trocas de DOM) ---------- */
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('#theme-toggle')) {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
      syncThemeIcons();
      return;
    }

    const toggle = target.closest('[data-mega-toggle]');
    if (toggle) {
      setMega(!isMegaOpen());
      return;
    }
    if (target.closest('[data-mega-scrim]')) {
      setMega(false);
      return;
    }
    if (isMegaOpen() && target.closest('#mega a')) {
      setMega(false);
    }

    const searchTrigger = target.closest('[data-search-open]');
    if (searchTrigger) {
      event.preventDefault();
      openSearch();
      return;
    }
    if (target.closest('[data-search-close]')) {
      searchDialog()?.close();
      return;
    }
    if (target.hasAttribute('data-dialog-backdrop') && target.closest('#search-dialog')) {
      searchDialog()?.close();
    }

    // Sem o diálogo na página, o link segue para /#sponsor.
    if (target.closest('[data-sponsor-open]') && openSponsor()) {
      event.preventDefault();
      return;
    }
    if (target.closest('[data-sponsor-close]')) {
      sponsorDialog()?.close();
      return;
    }
    if (target.hasAttribute('data-dialog-backdrop') && target.closest('#sponsor-dialog')) {
      sponsorDialog()?.close();
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable;

    if ((event.key === 'k' || event.key === 'K') && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      openSearch();
      return;
    }
    if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey) {
      event.preventDefault();
      openSearch();
      return;
    }
    if (event.key === 'Escape' && isMegaOpen()) {
      setMega(false, true);
      return;
    }
    if (target.id === 'search-input') {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        moveActive(1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        moveActive(-1);
      }
    }
  });

  document.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.id === 'search-input') void runSearch(target.value);
  });

  document.addEventListener('submit', (event) => {
    const form = event.target as HTMLFormElement;
    if (form.id !== 'search-form') return;
    event.preventDefault();
    const options = Array.from(document.querySelectorAll<HTMLAnchorElement>('#search-results a'));
    const chosen = options[activeIndex] ?? options[0];
    if (chosen) window.location.href = chosen.href;
  });

  document.addEventListener('mouseover', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLElement>('[data-mega-cat]');
    if (link) activatePreview(link.dataset.megaCat as string);
  });
  document.addEventListener('focusin', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLElement>('[data-mega-cat]');
    if (link) activatePreview(link.dataset.megaCat as string);
  });

  desktop.addEventListener('change', () => {
    if (isMegaOpen()) setMega(false);
  });

  /* ---------- Cabeçalho que recolhe ao rolar para baixo ---------- */
  let lastY = window.scrollY;
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const wrap = document.getElementById('site-header-wrap');
        const y = window.scrollY;
        if (wrap && !isMegaOpen()) {
          if (y > 320 && y > lastY + 8) wrap.setAttribute('data-hidden', 'true');
          else if (y < lastY - 8 || y <= 320) wrap.removeAttribute('data-hidden');
        }
        lastY = y;
        ticking = false;
      });
    },
    { passive: true },
  );

  // Se o visitante chegou por ?search=focus (link antigo), abre a busca.
  const params = new URLSearchParams(window.location.search);
  if (params.get('search') === 'focus' && window.location.pathname !== '/posts/') openSearch();

  syncThemeIcons();
  document.addEventListener('astro:page-load', syncThemeIcons);
  document.addEventListener('astro:after-swap', syncThemeIcons);
</script>
