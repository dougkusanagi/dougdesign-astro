---
/**
 * Slot de anúncio do Google AdSense.
 * O script só é carregado após o consentimento (ver Layout). Sem consentimento o
 * bloco não ocupa espaço; com consentimento, reserva altura conforme `size`
 * para evitar deslocamento de layout (CLS) e colapsa se não houver preenchimento.
 */
interface Props {
  slot: string;
  layout?: string;
  layoutKey?: string;
  format?: string;
  fullWidthResponsive?: boolean;
  class?: string;
  style?: string;
  simulatedText?: string;
  priority?: 'high' | 'low' | 'auto';
  size?: 'leaderboard' | 'rectangle' | 'tall' | 'infeed' | 'article';
}

const {
  slot,
  layout,
  layoutKey,
  format,
  fullWidthResponsive,
  class: className = '',
  style = 'display:block',
  simulatedText = 'Google AdSense',
  priority = 'auto',
  size = 'leaderboard',
} = Astro.props;

const isDev = import.meta.env.DEV;
---

<div
  class={className}
  data-adsense-container="true"
  data-adsense-state="pending"
  data-adsense-priority={priority}
  data-adsense-loaded="false"
  data-ad-size={size}
  aria-busy="true"
>
  <span class="ad-label" data-adsense-label>Publicidade</span>
  <div class="ad-frame">
    <ins
      class="adsbygoogle"
      style={style}
      data-ad-client="ca-pub-5927498436558135"
      data-ad-slot={slot}
      data-adsense-priority={priority}
      {...(format ? { 'data-ad-format': format } : {})}
      {...(fullWidthResponsive ? { 'data-full-width-responsive': 'true' } : {})}
      {...(layout ? { 'data-ad-layout': layout } : {})}
      {...(layoutKey ? { 'data-ad-layout-key': layoutKey } : {})}
      data-adsense-loaded="false"
    ></ins>
  </div>
  {isDev && (
    <div class="mt-1 text-[0.5rem] font-semibold uppercase tracking-wider text-ink-3">
      {simulatedText} (Slot: {slot}) - Prioridade: {priority}
    </div>
  )}
</div>
