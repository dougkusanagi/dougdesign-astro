<section class="mt-12 border-t border-line pt-10" aria-labelledby="comments-title">
  <h2 id="comments-title" class="font-display text-xl font-extrabold tracking-tight text-ink">Comentários</h2>
  <div id="giscus-shell" class="panel mt-4 p-4 sm:p-5">
    <p class="text-sm text-ink-2">
      Os comentários usam o Giscus e são carregados só quando você pedir.
    </p>
    <button id="giscus-load-trigger" type="button" class="btn btn-outline mt-4">
      Carregar comentários
    </button>
    <div id="giscus-thread" class="mt-6"></div>
  </div>
</section>

<script is:inline>
  const setupGiscus = () => {
    const trigger = document.getElementById('giscus-load-trigger');
    const thread = document.getElementById('giscus-thread');

    if (!trigger || !thread) return;

    const loadGiscus = () => {
      const consentKey = 'dougdesign-comments-consent-v1';
      const hasCommentsConsent = localStorage.getItem(consentKey) === 'comments-accepted';
      
      if (!hasCommentsConsent) {
        alert('Você precisa aceitar os comentários para visualizá-los.');
        return;
      }
      
      if (thread.dataset.loaded === 'true') return;
      thread.dataset.loaded = 'true';
      trigger.remove();

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'dougdesign/blog-comments');
      script.setAttribute('data-repo-id', 'R_kgDOH...');
      script.setAttribute('data-category', 'Announcements');
      script.setAttribute('data-category-id', 'DIC_kwDOH...');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', 'preferred_color_theme');
      script.setAttribute('data-lang', 'pt');
      script.crossOrigin = 'anonymous';
      script.async = true;
      thread.appendChild(script);
    };

    trigger.onclick = loadGiscus;
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGiscus, { once: true });
  } else {
    setupGiscus();
  }

  document.addEventListener('astro:page-load', setupGiscus);
</script>
