---
import Icon from './Icon.astro';
import AdSense from './AdSense.astro';
import LivePixWidget from './LivePixWidget.astro';
import { getPublishedPosts, getPostSlug, getPostUrl, getCategorySlug } from '../lib/blog';
import { categoryLabelOf } from '../lib/nav';

// Curadoria "Mais lidos": resolvida contra o acervo real (sem links quebrados).
const MOST_READ = [
  'palia-royal-highlands-como-se-preparar-expansao',
  'deepseek-revolucao-ia-chinesa-algoritmos-eficientes',
  'melhores-jogos-indie-game-pass',
  'web-components-em-2026-a-chave-para-componentes-reutilizaveis-e-um-design-system-robusto-no-seu-projeto-web',
  'codigo-limpo-typescript-2026',
  'calendario-lancamentos-games-2026-ps5-xbox-switch-2-pc',
  'ps-plus-abril-2026-quais-jogos-baixar-primeiro',
  'switch-2-vale-para-quem-ja-tem-switch-oled',
];

const posts = await getPublishedPosts();
const mostRead = MOST_READ.map((id) => posts.find((post) => post.id === id || getPostSlug(post) === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post))
  .slice(0, 6);

const gear = [
  { name: 'Mouse Logitech G502 Hero', price: 'R$ 279,90', image: 'https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?q=70&w=120&auto=format&fit=crop' },
  { name: 'Teclado mecânico Keychron K2 v2', price: 'R$ 689,00', image: 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?q=70&w=120&auto=format&fit=crop' },
  { name: 'Microfone HyperX QuadCast S', price: 'R$ 899,00', image: 'https://images.unsplash.com/photo-1590608897129-79da98d15969?q=70&w=120&auto=format&fit=crop' },
];
---

<aside class="min-w-0 space-y-8 lg:col-span-4" aria-label="Barra lateral">
  <AdSense
    slot="3980100424"
    format="auto"
    fullWidthResponsive={true}
    style="display:block"
    size="rectangle"
    simulatedText="Google AdSense - Retângulo Médio Lateral"
  />

  <section class="panel p-5" aria-labelledby="mais-lidos-title">
    <h2 id="mais-lidos-title" class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight text-ink">
      <Icon name="flame" class="h-4 w-4 text-orange-500" /> Mais lidos
    </h2>
    <ol class="mt-3 divide-y divide-line">
      {mostRead.map((post, index) => (
        <li class="group relative flex gap-4 py-3.5 first:pt-2">
          <span class="w-7 shrink-0 font-display text-2xl font-extrabold leading-none tracking-tight text-ink-3 transition-colors group-hover:text-accent">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="min-w-0">
            <span class="cat" data-cat={getCategorySlug(post.data.category)}>{categoryLabelOf(post.data.category)}</span>
            <a href={getPostUrl(post)} class="stretched mt-1 block font-display text-[0.9375rem] font-bold leading-snug text-ink transition-colors group-hover:text-accent">
              {post.data.title}
            </a>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <LivePixWidget />

  <section class="panel p-5" aria-labelledby="gear-title">
    <h2 id="gear-title" class="flex items-center gap-2 font-display text-base font-extrabold tracking-tight text-ink">
      <Icon name="shopping-bag" class="h-4 w-4 text-accent" /> Equipamento recomendado
    </h2>
    <ul class="mt-3 space-y-3.5">
      {gear.map((item) => (
        <li class="flex items-center gap-3">
          <img src={item.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-xl bg-surface-2 object-cover" />
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-ink">{item.name}</p>
            <p class="text-sm font-bold text-accent">{item.price}</p>
            <a href="https://amazon.com.br" target="_blank" rel="noopener noreferrer sponsored" class="inline-flex items-center gap-1 text-[0.6875rem] font-bold uppercase tracking-wider text-ink-3 hover:text-accent">
              Ver na Amazon <Icon name="external-link" class="h-3 w-3" />
            </a>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-[0.6875rem] leading-snug text-ink-3">Os links para a Amazon podem ser de afiliados. Veja os <a href="/termos/" class="underline underline-offset-2 hover:text-accent">Termos de Uso</a>.</p>
  </section>

  <!-- Anúncio que acompanha a rolagem: alta visibilidade sem cobrir o texto -->
  <div class="lg:sticky lg:top-24">
    <AdSense
      slot="8098120205"
      format="auto"
      fullWidthResponsive={true}
      style="display:block"
      size="tall"
      simulatedText="Google AdSense - Lateral fixo"
    />
  </div>
</aside>
