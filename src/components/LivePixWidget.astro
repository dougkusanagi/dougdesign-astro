---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section id="sponsor" class:list={['panel relative scroll-mt-28 overflow-hidden p-4 sm:p-5', className]} aria-labelledby="sponsor-title">
  <div class="mb-3">
    <h2 id="sponsor-title" class="font-display text-base font-extrabold tracking-tight text-ink">Apoie o Doug Design</h2>
    <p class="mt-0.5 text-xs leading-relaxed text-ink-3">Conteúdo gratuito e sem paywall. Se ajudou, uma contribuição mantém o projeto no ar.</p>
  </div>
  <div data-livepix-fit class="relative overflow-hidden rounded-xl bg-surface-2" style="height: 110px;">
    <a
      href="https://livepix.gg/dougkusanagi"
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 z-20 cursor-pointer"
      title="Apoie o Doug Design no LivePix"
    >
      <span class="sr-only">Apoiar no LivePix</span>
    </a>
    <iframe
      data-deferred-src="https://widget.livepix.gg/embed/0776a902-0b92-40c3-bcd2-c1291a81b995"
      class="absolute left-0 top-0 z-10 block border-none"
      style="width: 360px; height: 110px; transform-origin: 0 0;"
      title="Apoie o Doug Design"
      loading="lazy"
    ></iframe>
  </div>
</section>

<script is:inline>
  (() => {
    const state = window.__dougLivePix || (window.__dougLivePix = {});
    if (state.install) {
      state.install();
      return;
    }

    state.install = () => {
      const activateFrame = (frame) => {
        if (frame.dataset.loaded === 'true') return;
        const deferredSrc = frame.dataset.deferredSrc;
        if (!deferredSrc) return;
        frame.dataset.loaded = 'true';
        frame.src = deferredSrc;
      };

      const frames = document.querySelectorAll('iframe[data-deferred-src]');
      if (!frames.length) return;

      if (!('IntersectionObserver' in window)) {
        frames.forEach(activateFrame);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const frame = entry.target;
          activateFrame(frame);
          observer.unobserve(frame);
        });
      }, { rootMargin: '200px 0px' });

      frames.forEach((frame) => {
        if (frame.dataset.observing === 'true') return;
        frame.dataset.observing = 'true';
        observer.observe(frame);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', state.install, { once: true });
    } else {
      state.install();
    }

    document.addEventListener('astro:page-load', state.install);
  })();
</script>
