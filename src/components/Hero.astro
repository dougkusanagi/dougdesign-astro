---
import { getPublishedPosts } from '../lib/blog';
import PostCard from './PostCard.astro';

const [lead, ...others] = (await getPublishedPosts()).slice(0, 6);
---

{lead && (
  <section class="wrap pt-6 sm:pt-10" aria-label="Destaques da home">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <PostCard post={lead} variant="lead" loading="eager" fetchpriority="high" />
      </div>
      <div class="lg:col-span-5">
        <p class="eyebrow">Mais recentes</p>
        <div class="mt-4 divide-y divide-line">
          {others.map((post) => (
            <div class="py-5 first:pt-2 last:pb-0">
              <PostCard post={post} variant="compact" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
