---
import Icon from './Icon.astro';
import { getCategoryStats } from '../lib/nav';

const stats = await getCategoryStats();
---

<section class="relative isolate mt-16 overflow-hidden text-white sm:mt-24" aria-labelledby="explore-title">
  <div class="absolute inset-0 -z-10" style="background: radial-gradient(80% 120% at 100% 0%, #3b8dff 0%, rgba(59,141,255,0) 55%), linear-gradient(160deg, #0866fa 0%, #0a4fd0 55%, #0a3a9e 100%);"></div>
  <span class="brand-d" style="left:-9rem;bottom:-9rem;width:24rem;height:24rem;background:rgb(255 255 255 / 0.06);border-radius:999px;"></span>
  <span class="brand-square" style="right:6%;top:2.5rem;width:5.5rem;height:5.5rem;background:rgb(255 255 255 / 0.08);"></span>

  <div class="wrap py-14 sm:py-20">
    <p class="eyebrow !text-white">Explore por tema</p>
    <h2 id="explore-title" class="mt-2 max-w-3xl font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[1.04] tracking-[-0.03em]">
      Sobre o que você quer ler hoje?
    </h2>

    <div class="mt-9 grid grid-cols-2 gap-3 sm:mt-12 sm:gap-4 md:grid-cols-4">
      {stats.map((category) => (
        <a
          href={`/category/${category.slug}/`}
          class="group relative flex min-h-32 flex-col justify-between rounded-2xl bg-white/10 p-4 ring-1 ring-white/20 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:text-brand-800 hover:shadow-pop sm:min-h-44 sm:p-5"
        >
          <span class="flex items-center justify-between text-xs font-bold">
            {category.count} artigos
            <Icon name="arrow-up-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </span>
          <span>
            <span class="block font-display text-xl font-extrabold leading-tight tracking-[-0.02em] sm:text-2xl">{category.label}</span>
            <span class="mt-1.5 line-clamp-2 hidden text-[0.8125rem] leading-snug sm:block">{category.blurb}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
