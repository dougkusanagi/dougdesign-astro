---
import Icon from './Icon.astro';
---

<!-- Aberto pelos botões [data-sponsor-open] (Header e Footer). O iframe só recebe o src na primeira abertura. -->
<dialog id="sponsor-dialog" class="sheet" aria-labelledby="sponsor-dialog-title">
  <div class="grid min-h-full place-items-center p-4" data-dialog-backdrop>
    <div class="sheet-card panel w-full max-w-lg p-6 shadow-pop sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="sponsor-dialog-title" class="font-display text-2xl font-extrabold tracking-tight text-ink">Apoie o Doug Design</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            Conteúdo gratuito e sem paywall. Se ajudou, uma contribuição mantém o projeto no ar.
          </p>
        </div>
        <button type="button" data-sponsor-close class="icon-btn -mr-2 -mt-2 shrink-0" aria-label="Fechar">
          <Icon name="x" class="h-5 w-5" />
        </button>
      </div>

      <div class="mt-5 overflow-hidden rounded-xl bg-surface-2">
        <iframe
          data-src="https://widget.livepix.gg/embed/0776a902-0b92-40c3-bcd2-c1291a81b995"
          class="block w-full border-none"
          style="aspect-ratio: 800 / 200; min-height: 110px; max-height: 200px; height: auto;"
          title="Meta de contribuição do Doug Design"
          tabindex="-1"
        ></iframe>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="https://livepix.gg/dougkusanagi"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <Icon name="heart" class="h-4 w-4" /> Contribuir no LivePix
        </a>
        <button type="button" data-sponsor-close class="btn btn-outline">Agora não</button>
      </div>
      <p class="mt-3 text-xs text-ink-3">A contribuição é feita na página do LivePix, que abre em outra aba.</p>
    </div>
  </div>
</dialog>
