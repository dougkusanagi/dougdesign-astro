---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getPostUrl, getCategorySlug } from '../lib/blog';
import { categoryLabelOf, formatPostDate } from '../lib/nav';

type Variant = 'lead' | 'card' | 'row' | 'compact' | 'hero' | 'sidebar' | 'highlight' | 'feed';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      meta_description?: string;
      description?: string;
      pubDate: Date;
      author: string;
      category: string;
      image?: any;
      readingTime?: string;
    };
  };
  variant?: Variant;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Renders the title as <h1>/<h2>/<h3>. Defaults per variant. */
  headingLevel?: 'h1' | 'h2' | 'h3';
}

// Nomes antigos continuam válidos.
const LEGACY: Record<string, 'lead' | 'card' | 'row' | 'compact'> = {
  hero: 'lead',
  sidebar: 'card',
  highlight: 'card',
  feed: 'row',
};

const {
  post,
  variant: rawVariant = 'card',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  headingLevel,
} = Astro.props;

const variant = (LEGACY[rawVariant] ?? rawVariant) as 'lead' | 'card' | 'row' | 'compact';
const { title, pubDate, author, category, image, readingTime } = post.data;
const excerpt = post.data.description || post.data.meta_description || '';
const url = getPostUrl(post as any);
const catSlug = getCategorySlug(category);
const catLabel = categoryLabelOf(category);
const date = formatPostDate(pubDate);
const Heading = headingLevel ?? (variant === 'lead' ? 'h2' : 'h3');

const THUMB_WIDTHS = [320, 480, 720];
const LEAD_WIDTHS = [400, 640, 800, 960, 1280];
---

{variant === 'lead' && (
  <article class:list={['group relative', className]}>
    <div class="thumb !aspect-[4/3] sm:!aspect-[16/9] !rounded-[1.25rem] sm:!rounded-3xl">
      {image && (
        <Image
          src={image}
          alt=""
          width={1280}
          height={720}
          widths={LEAD_WIDTHS}
          sizes="(min-width: 1280px) 689px, (min-width: 1024px) calc((100vw - 112px) * 0.5833), calc(100vw - 32px)"
          layout="constrained"
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
        />
      )}
    </div>
    <div class="mt-5 sm:mt-6">
      <div class="meta">
        <span class="cat" data-cat={catSlug}>{catLabel}</span>
        <span class="sep">•</span>
        <time datetime={pubDate.toISOString()}>{date}</time>
        {readingTime && (<><span class="sep">•</span><span>{readingTime} de leitura</span></>)}
      </div>
      <Heading class="h-display mt-3 text-[clamp(1.75rem,3.6vw,2.875rem)]">
        <a href={url} class="stretched hover-title">{title}</a>
      </Heading>
      {excerpt && <p class="mt-3 line-clamp-3 max-w-2xl text-base leading-relaxed text-ink-2 sm:text-lg">{excerpt}</p>}
      <p class="meta mt-4">Por <span class="text-ink">{author}</span></p>
    </div>
  </article>
)}

{variant === 'card' && (
  <article class:list={['group relative flex flex-col', className]}>
    <div class="thumb">
      {image && (
        <Image
          src={image}
          alt=""
          width={720}
          height={405}
          widths={THUMB_WIDTHS}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
          layout="constrained"
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
        />
      )}
    </div>
    <div class="mt-4 flex flex-1 flex-col">
      <div class="meta">
        <span class="cat" data-cat={catSlug}>{catLabel}</span>
        {readingTime && (<><span class="sep">•</span><span>{readingTime}</span></>)}
      </div>
      <Heading class="mt-2 font-display text-[1.1875rem] font-bold leading-snug tracking-[-0.015em] text-ink">
        <a href={url} class="stretched hover-title">{title}</a>
      </Heading>
      {excerpt && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-3">{excerpt}</p>}
      <p class="meta mt-auto pt-3"><time datetime={pubDate.toISOString()}>{date}</time><span class="sep">•</span><span>{author}</span></p>
    </div>
  </article>
)}

{variant === 'row' && (
  <article class:list={['group relative grid grid-cols-[1fr_auto] gap-4 border-b border-line py-6 sm:gap-6 first:pt-0', className]}>
    <div class="flex min-w-0 flex-col">
      <div class="meta">
        <span class="cat" data-cat={catSlug}>{catLabel}</span>
        <span class="sep hidden sm:inline">•</span>
        <time class="hidden sm:inline" datetime={pubDate.toISOString()}>{date}</time>
      </div>
      <Heading class="mt-2 font-display text-[1.0625rem] font-bold leading-snug tracking-[-0.015em] text-ink sm:text-[1.3125rem]">
        <a href={url} class="stretched hover-title">{title}</a>
      </Heading>
      {excerpt && <p class="mt-2 hidden line-clamp-2 text-[0.9375rem] leading-relaxed text-ink-3 sm:block">{excerpt}</p>}
      <p class="meta mt-auto pt-3">
        <span>{author}</span>
        <span class="sep sm:hidden">•</span>
        <time class="sm:hidden" datetime={pubDate.toISOString()}>{date}</time>
        {readingTime && (<><span class="sep">•</span><span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3 w-3" /> {readingTime}</span></>)}
      </p>
    </div>
    <div class="thumb !aspect-square h-[6.5rem] w-[6.5rem] self-start !rounded-xl sm:!aspect-[16/10] sm:h-auto sm:w-56 sm:!rounded-2xl">
      {image && (
        <Image
          src={image}
          alt=""
          width={480}
          height={300}
          widths={THUMB_WIDTHS}
          sizes="(min-width: 640px) 224px, 104px"
          layout="constrained"
          loading={loading}
          decoding="async"
        />
      )}
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class:list={['group relative grid grid-cols-[1fr_auto] items-start gap-4', className]}>
    <div class="min-w-0">
      <div class="meta">
        <span class="cat" data-cat={catSlug}>{catLabel}</span>
      </div>
      <Heading class="mt-1.5 line-clamp-3 font-display text-base font-bold leading-snug tracking-[-0.01em] text-ink">
        <a href={url} class="stretched hover-title">{title}</a>
      </Heading>
      <p class="meta mt-1.5"><time datetime={pubDate.toISOString()}>{date}</time></p>
    </div>
    <div class="thumb !aspect-[4/3] w-24 !rounded-xl sm:w-28">
      {image && (
        <Image
          src={image}
          alt=""
          width={320}
          height={240}
          widths={[96, 192, 288, 320]}
          sizes="(min-width: 640px) 112px, 96px"
          layout="constrained"
          loading={loading}
          decoding="async"
        />
      )}
    </div>
  </article>
)}
