---
import SEO from '../components/SEO.astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BetaNotice from '../components/BetaNotice.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import AdBlockModal from '../components/AdBlockModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: any;
  canonicalUrl?: string;
  type?: string;
  pubDate?: Date | string;
  author?: string;
  enableClientRouter?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  /** Renders the shared header, beta notice and footer. Disable only for bare pages. */
  chrome?: boolean;
}

const props = Astro.props;
const { enableClientRouter = false, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth" data-ads="on">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f6f7fa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0e17" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/logo-doug-design-icone-puro.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Doug Design Blog" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="s7__DsfJA9DSo0WeclTFM5_gc5WWGIs2IlLUDD58L_Q" />
		
		<SEO {...props} />
		<Font cssVariable="--font-outfit" preload />
		<Font cssVariable="--font-plus-jakarta-sans" preload />
		{enableClientRouter && <ClientRouter />}

		<!-- WebMCP AI Agent tools registration -->
		<script is:inline>
			(function() {
				const modelContext = document.modelContext || navigator.modelContext;
				if (modelContext && typeof modelContext.registerTool === 'function') {
					try {
						modelContext.registerTool({
							name: "buscarArtigos",
							description: "Busca artigos no blog Doug Design sobre tecnologia, programação, games ou inteligência artificial.",
							inputSchema: {
								type: "object",
								properties: {
									query: {
										type: "string",
										description: "Termo de busca ou palavra-chave."
									}
								},
								required: ["query"]
							},
							execute: async (args) => {
								if (args && args.query) {
									window.location.href = `/posts/?search=${encodeURIComponent(args.query)}`;
									return { success: true, message: `Buscando por: ${args.query}` };
								}
								return { success: false, message: "Query não fornecida." };
							}
						});
					} catch (e) {
						console.error("WebMCP Tool registration error:", e);
					}
				}
			})();
		</script>

		<script is:inline>
			(function() {
				var CONSENT_KEY = 'dougdesign-consent-v1';
				var ANALYTICS_CONSENT_KEY = 'dougdesign-analytics-consent-v1';
				var ADS_CONSENT_KEY = 'dougdesign-ads-consent-v1';
				var GA_TAG_ID = 'GT-WPDGLZ6';
				var GOOGLE_ADS_ID = 'AW-5927498436558135';
				var ADSENSE_CLIENT = 'ca-pub-5927498436558135';

				window.__doug = window.__doug || {};
				var doug = window.__doug;
				window.dataLayer = window.dataLayer || [];
				window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };

				var stored = function(key) {
					try { return window.localStorage.getItem(key); } catch (e) { return null; }
				};
				var hasAccepted = function(specificKey) {
					return stored(specificKey) === 'accepted' || stored(CONSENT_KEY) === 'accepted';
				};

				// Visita interna (dono do site): ?interno=1 marca este navegador e ?interno=0
				// desfaz. Marcado, não carrega a tag do Google nem anúncios, para não contar
				// visitas próprias no GA4 nem gerar impressões/cliques acidentais no AdSense.
				var INTERNAL_KEY = 'dougdesign-internal-v1';
				try {
					var internalParam = new URLSearchParams(window.location.search).get('interno');
					if (internalParam === '1') window.localStorage.setItem(INTERNAL_KEY, '1');
					else if (internalParam === '0') window.localStorage.removeItem(INTERNAL_KEY);
				} catch (e) {}
				doug.isInternal = stored(INTERNAL_KEY) === '1';
				if (doug.isInternal) {
					document.documentElement.setAttribute('data-internal', 'on');
					console.info('Doug Design: visita interna (sem GA4 e sem anúncios). Use ?interno=0 para desfazer.');
				}

				doug.hasMarketingConsent = function() {
					return !doug.isInternal && hasAccepted(ANALYTICS_CONSENT_KEY);
				};
				doug.hasAdsConsent = function() {
					return hasAccepted(ADS_CONSENT_KEY);
				};

				// Os anúncios sempre carregam. O consentimento só decide se podem usar
				// cookies/personalização (Consent Mode abaixo). Em EEE/Reino Unido/Suíça a
				// mensagem de consentimento do próprio AdSense (Privacidade e mensagens)
				// é exibida pelo adsbygoogle.js.
				doug.syncAdsFlag = function() {
					document.documentElement.setAttribute('data-ads', doug.isInternal ? 'off' : 'on');
				};
				doug.syncAdsFlag();

				// Advanced Consent Mode: the tag can send cookieless, aggregate pings
				// before a choice, while storage and personalized advertising stay denied.
				if (!doug.googleConsentInitialized) {
					window.gtag('consent', 'default', {
						analytics_storage: doug.hasMarketingConsent() ? 'granted' : 'denied',
						ad_storage: doug.hasAdsConsent() ? 'granted' : 'denied',
						ad_user_data: doug.hasAdsConsent() ? 'granted' : 'denied',
						ad_personalization: doug.hasAdsConsent() ? 'granted' : 'denied',
						wait_for_update: 500
					});
					doug.googleConsentInitialized = true;
				}

				doug.updateGoogleConsent = function() {
					window.gtag('consent', 'update', {
						analytics_storage: doug.hasMarketingConsent() ? 'granted' : 'denied',
						ad_storage: doug.hasAdsConsent() ? 'granted' : 'denied',
						ad_user_data: doug.hasAdsConsent() ? 'granted' : 'denied',
						ad_personalization: doug.hasAdsConsent() ? 'granted' : 'denied'
					});
				};

				doug.loadScriptOnce = function(id, src, attributes) {
					attributes = attributes || {};
					doug.scriptPromises = doug.scriptPromises || {};
					if (doug.scriptPromises[id]) return doug.scriptPromises[id];
					var existing = document.getElementById(id);
					if (existing) return Promise.resolve(existing);

					doug.scriptPromises[id] = new Promise(function(resolve, reject) {
						var script = document.createElement('script');
						script.id = id;
						script.src = src;
						script.async = true;
						Object.entries(attributes).forEach(function(entry) {
							var key = entry[0], value = entry[1];
							if (value === true) script.setAttribute(key, '');
							else if (value !== false && value != null) script.setAttribute(key, String(value));
						});
						script.onload = function() { resolve(script); };
						script.onerror = function(error) { delete doug.scriptPromises[id]; reject(error); };
						document.head.appendChild(script);
					});
					return doug.scriptPromises[id];
				};

				doug.syncAdsenseState = function(ad) {
					if (!ad || !ad.closest) return;
					var container = ad.closest('[data-adsense-container]');
					if (!container) return;
					var status = ad.getAttribute('data-ad-status');
					if (status === 'filled') {
						container.dataset.adsenseState = 'filled';
						container.dataset.adsenseLoaded = 'true';
						container.setAttribute('aria-busy', 'false');
						ad.dataset.adsenseLoaded = 'true';
					} else if (status === 'unfilled' || (status && status.indexOf('unfill') === 0)) {
						container.dataset.adsenseState = 'unfilled';
						container.dataset.adsenseLoaded = 'false';
						container.setAttribute('aria-busy', 'false');
						ad.dataset.adsenseLoaded = 'false';
					}
				};

				doug.observeAdsense = function() {
					if (!window.MutationObserver || !document.body) return;
					if (doug.adsenseObserverTarget === document.body) return;
					if (doug.adsenseObserver) doug.adsenseObserver.disconnect();
					doug.adsenseObserverTarget = document.body;
					doug.adsenseObserver = new MutationObserver(function(mutations) {
						var shouldInitialize = false;
						mutations.forEach(function(mutation) {
							if (mutation.type === 'attributes') {
								doug.syncAdsenseState(mutation.target);
							} else if (mutation.addedNodes && mutation.addedNodes.length) {
								shouldInitialize = true;
							}
						});
						if (shouldInitialize) doug.initAdsenseBlocks();
					});
					doug.adsenseObserver.observe(document.body, {
						childList: true,
						subtree: true,
						attributes: true,
						attributeFilter: ['data-ad-status']
					});
				};

				doug.initAdsenseBlocks = function() {
					if (!window.adsbygoogle) return;
					doug.observeAdsense();
					document.querySelectorAll('ins.adsbygoogle[data-ad-client][data-ad-slot]').forEach(function(ad) {
						doug.syncAdsenseState(ad);
						if (ad.dataset.adsenseInitialized === 'true') return;
						// Request below-the-fold units as the reader approaches them.
						if ('IntersectionObserver' in window && ad.dataset.adsenseNearViewport !== 'true') {
							if (!doug.adVisibilityObserver) doug.adVisibilityObserver = new IntersectionObserver(function(entries) {
								entries.forEach(function(entry) {
									if (!entry.isIntersecting) return;
									entry.target.dataset.adsenseNearViewport = 'true';
									doug.adVisibilityObserver.unobserve(entry.target);
								});
								doug.initAdsenseBlocks();
							}, { rootMargin: '300px' });
							doug.adVisibilityObserver.observe(ad);
							return;
						}
						ad.dataset.adsenseInitialized = 'true';
						try {
							(window.adsbygoogle = window.adsbygoogle || []).push({});
							setTimeout(function() {
								var container = ad.closest('[data-adsense-container]');
								if (container && container.dataset.adsenseState === 'pending') {
									container.dataset.adsenseState = 'unfilled';
									container.setAttribute('aria-busy', 'false');
								}
							}, 10000);
						} catch (e) {
							delete ad.dataset.adsenseInitialized;
						}
					});
				};

				doug.initAdSense = function() {
					if (doug.isInternal) return;
					doug.observeAdsense();
					if (doug.adsenseReady) {
						doug.initAdsenseBlocks();
						return;
					}
					if (doug.adsenseLoading) return;
					doug.adsenseLoading = true;
					doug.loadScriptOnce('adsbygoogle-script', 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE_CLIENT, { crossorigin: 'anonymous' })
						.then(function() {
							doug.adsenseLoading = false;
							doug.adsenseReady = true;
							doug.observeAdsense();
							doug.initAdsenseBlocks();
							setTimeout(doug.initAdsenseBlocks, 300);
						})
						.catch(function(error) {
							doug.adsenseLoading = false;
							// A blocked/failed provider cannot fill any of the reserved units.
							document.querySelectorAll('[data-adsense-container][data-adsense-state="pending"]').forEach(function(container) {
								container.dataset.adsenseState = 'blocked';
								container.setAttribute('aria-busy', 'false');
							});
							console.warn('AdSense load error:', error);
						});
				};

				// Manual pageviews avoid duplicate config pageviews on Astro navigation.
				doug.trackPageView = function() {
					if (typeof window.gtag !== 'function') return;
					var path = window.location.pathname + window.location.search;
					if (doug.lastTrackedPath === path) return;
					doug.lastTrackedPath = path;
					window.gtag('event', 'page_view', {
						page_title: document.title,
						page_location: window.location.href,
						page_path: window.location.pathname
					});
				};

				doug.trackEvent = function(name, params) {
					if (!doug.hasMarketingConsent() || typeof window.gtag !== 'function') return;
					window.gtag('event', name, params || {});
				};

				doug.initEngagementTracking = function() {
					if (!doug.hasMarketingConsent() || doug.engagementTrackingReady) return;
					doug.engagementTrackingReady = true;
					var sent = {};
					window.addEventListener('scroll', function() {
						var height = document.documentElement.scrollHeight - window.innerHeight;
						if (!height) return;
						var percent = Math.floor((window.scrollY / height) * 100);
						[25, 50, 75, 90].forEach(function(mark) {
							if (percent >= mark && !sent[mark]) {
								sent[mark] = true;
								doug.trackEvent('scroll_depth', { percent_scrolled: mark });
							}
						});
					}, { passive: true });

					if (!doug.vitalsReady && 'PerformanceObserver' in window) {
						doug.vitalsReady = true;
						var reportVital = function(name, value) {
							doug.trackEvent('web_vital', { metric_name: name, metric_value: Math.round(value * 100) / 100 });
						};
						try { new PerformanceObserver(function(list) { var entry = list.getEntries().pop(); if (entry) reportVital('LCP', entry.startTime); }).observe({ type: 'largest-contentful-paint', buffered: true }); } catch (e) {}
						try { new PerformanceObserver(function(list) { list.getEntries().forEach(function(entry) { if (!entry.hadRecentInput) reportVital('CLS', entry.value); }); }).observe({ type: 'layout-shift', buffered: true }); } catch (e) {}
						try { new PerformanceObserver(function(list) { var entry = list.getEntries().pop(); if (entry) reportVital('INP', entry.duration); }).observe({ type: 'event', buffered: true, durationThreshold: 40 }); } catch (e) {}
					}
				};

				doug.initGoogleTag = function() {
					if (doug.isInternal || doug.googleTagReady || doug.googleTagLoading) return;
					doug.googleTagLoading = true;
					doug.loadScriptOnce('gtag-script', 'https://www.googletagmanager.com/gtag/js?id=' + GA_TAG_ID).then(function() {
						window.gtag('set', 'linker', { domains: ['dougdesign.com.br', 'www.dougdesign.com.br'] });
						window.gtag('js', new Date());
						window.gtag('set', 'developer_id.dZTNiMT', true);
						window.gtag('config', GA_TAG_ID, { send_page_view: false });
						window.gtag('config', GOOGLE_ADS_ID, { send_page_view: false });
						doug.googleTagLoading = false;
						doug.googleTagReady = true;
						doug.trackPageView();
						doug.initEngagementTracking();
					}).catch(function(error) {
						doug.googleTagLoading = false;
						console.warn('Google tag load error:', error);
					});
				};

				doug.enableMarketing = function() {
					if (!doug.hasMarketingConsent()) return;
					doug.updateGoogleConsent();
					doug.initGoogleTag();
					doug.initEngagementTracking();
					if (!doug.marketingEnabled) {
						doug.marketingEnabled = true;
						doug.loadScriptOnce('tally-widget-script', 'https://tally.so/widgets/embed.js').catch(function(error) {
							console.warn('Tally load error:', error);
						});
					}
				};

				// Give the visible content a chance to paint before third-party work.
				// This runs for every visitor, independently of cookie consent.
				var boot = function() {
					doug.updateGoogleConsent();
					if (doug.bootScheduled) return;
					doug.bootScheduled = true;
					var image = document.querySelector('main img[fetchpriority="high"]');
					var contentReady = image && image.decode ? image.decode().catch(function() {}) : Promise.resolve();
					Promise.race([contentReady, new Promise(function(resolve) { setTimeout(resolve, 2500); })]).then(function() {
						requestAnimationFrame(function() { requestAnimationFrame(function() {
							var start = function() {
								doug.bootScheduled = false;
								doug.initAdSense();
								doug.initGoogleTag();
								if (doug.hasMarketingConsent()) doug.enableMarketing();
							};
							if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1000 });
							else setTimeout(start, 0);
						}); });
					});
				};

				if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
				else boot();

				document.addEventListener('doug:consent-granted', function() {
					doug.syncAdsFlag();
					doug.enableMarketing();
					doug.initAdSense();
				});
				document.addEventListener('doug:consent-denied', function() {
					doug.syncAdsFlag();
					doug.updateGoogleConsent();
				});
				document.addEventListener('astro:page-load', function() {
					if (doug.adVisibilityObserver) doug.adVisibilityObserver.disconnect();
					doug.syncAdsFlag();
					boot();
					doug.trackPageView();
					doug.initAdsenseBlocks();
				});
			})();
		</script>

		<!-- Theme Initial Script to avoid flash/FOUC -->
		<script is:inline>
			const applyTheme = () => {
				const theme = localStorage.getItem('theme') || 
					(!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			};
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);

			// Beta notice: hide before first paint when it was already dismissed.
			const applyBetaFlag = () => {
				try {
					if (localStorage.getItem('dougdesign-beta-notice-v1') === 'dismissed') {
						document.documentElement.setAttribute('data-beta-dismissed', '');
					}
				} catch (e) {}
			};
			applyBetaFlag();
			document.addEventListener('astro:after-swap', applyBetaFlag);
		</script>
	</head>
	<body class="min-h-screen">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white">Pular para o conteúdo</a>
		{chrome && <BetaNotice />}
		{chrome && <Header />}
		<slot />
		{chrome && <Footer />}
		<ConsentBanner />
		<AdBlockModal />
		<SpeedInsights />
	</body>
</html>
