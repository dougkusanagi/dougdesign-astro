---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getPublishedPosts } from '../../lib/blog';
import { authorSlug, getAuthorProfile } from '../../lib/authors';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const names = [...new Set(posts.map((post) => post.data.author))];
  return names.map((name) => ({ params: { author: authorSlug(name) }, props: { name } }));
}

const { name } = Astro.props;
const profile = getAuthorProfile(name);
const posts = (await getPublishedPosts()).filter((post) => post.data.author === name).slice(0, 24);
---

<Layout title={`${profile.name} — Doug Design`} description={`${profile.role}: ${profile.bio}`}>
  <main id="main">
    <PageHero eyebrow="Autor" title={profile.name} description={`${profile.role}. ${profile.bio}`} />

    <section class="wrap mt-12">
      <SectionHeading title="Artigos publicados" />
      <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => <PostCard post={post} variant="card" headingLevel="h3" loading={index < 3 ? 'eager' : 'lazy'} />)}
      </div>
    </section>
  </main>
</Layout>
