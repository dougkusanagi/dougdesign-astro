---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import AdSense from '../../components/AdSense.astro';
import Pagination from '../../components/Pagination.astro';
import LivePixWidget from '../../components/LivePixWidget.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts } from '../../lib/blog';
import { CATEGORIES } from '../../lib/nav';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPublishedPosts(), { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
  title={`Todas as Publicações - Página ${page.currentPage} - Doug Design`}
  description="Confira a lista completa de todos os artigos publicados no blog Doug Design sobre tecnologia, programação, games e inteligência artificial."
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
  <main id="main">
    <PageHero eyebrow="Arquivo" title="Todas as publicações">
      <p id="post-count-text" class="text-sm font-semibold text-ink-3">
        Página {page.currentPage} de {page.lastPage} ({page.total} artigos publicados no total).
      </p>
    </PageHero>

    <div class="wrap mt-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <!-- Filtro por categoria (usa o índice completo do site) -->
        <div id="category-pills" class="snap-row lg:!m-0 lg:!p-0" role="group" aria-label="Filtrar por categoria">
          <button type="button" data-category="all" aria-pressed="true" class="category-pill chip">Todos</button>
          {CATEGORIES.map((category) => (
            <button type="button" data-category={category.slug} aria-pressed="false" class="category-pill chip">{category.label}</button>
          ))}
        </div>

        <form
          toolname="buscarArtigos"
          tooldescription="Busca artigos no blog Doug Design sobre tecnologia, programação, games ou inteligência artificial."
          toolautosubmit="true"
          onsubmit="event.preventDefault();"
          class="relative w-full lg:max-w-xs"
          role="search"
        >
          <label for="archive-search" class="sr-only">Buscar artigos</label>
          <Icon name="search" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3" />
          <input type="search" id="archive-search" name="query" placeholder="Buscar em todo o blog…" autocomplete="off" class="field !rounded-full !py-2.5 !pl-10" />
        </form>
      </div>
    </div>

    <div class="wrap mt-8">
      <AdSense slot="6543940190" format="auto" fullWidthResponsive={true} size="leaderboard" simulatedText="AdSense - Topo Listagem" />
    </div>

    <div class="wrap mt-10">
      <div id="posts-grid" class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {page.data.map((post, index) => (
          <>
            <PostCard post={post} variant="card" headingLevel="h2" loading={index < 3 ? 'eager' : 'lazy'} />
            {index === 5 && (
              <div class="sm:col-span-2 lg:col-span-3" data-static-ad>
                <AdSense slot="7975185751" format="fluid" layoutKey="-fb+5w+4e-db+86" size="infeed" simulatedText="AdSense - Mid-Grid Listagem (In-feed)" />
              </div>
            )}
          </>
        ))}
      </div>

      <div id="search-empty-state" class="hidden py-16 text-center">
        <p class="text-ink-3">Nenhum artigo encontrado para a busca realizada.</p>
      </div>

      <div id="archive-pagination">
        <Pagination current={page.currentPage} last={page.lastPage} basePath="/posts/" />
      </div>

      <LivePixWidget className="mx-auto mt-16 max-w-2xl" />
    </div>
  </main>
</Layout>

<script is:inline>
  const setupArchiveSearch = () => {
    const searchInput = document.getElementById('archive-search');
    const countText = document.getElementById('post-count-text');
    const grid = document.getElementById('posts-grid');
    const emptyState = document.getElementById('search-empty-state');
    const pagination = document.getElementById('archive-pagination');

    if (!searchInput || !grid || searchInput.dataset.bound === 'true') return;
    searchInput.dataset.bound = 'true';

    const originalHtml = grid.innerHTML;
    const originalCountText = countText ? countText.textContent : '';

    const escapeHtml = (value) =>
      String(value ?? '').replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[character]);

    const slugify = (text) =>
      text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

    const CATEGORY_LABELS = {
      games: 'Games', tecnologia: 'Tecnologia', 'inteligencia-artificial': 'Inteligência Artificial',
      programacao: 'Programação', 'web-design': 'Web Design', mobile: 'Mobile', hardware: 'Hardware', educacao: 'Educação',
    };

    // Resultado de busca: versão só-texto do cartão (o índice não carrega imagens).
    function renderCard(post) {
      const date = new Date(post.pubDate).toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' }).replace(/\./g, '');
      const slug = escapeHtml(post.slug);
      const title = escapeHtml(post.title);
      const catSlug = slugify(post.category);
      const category = escapeHtml(CATEGORY_LABELS[catSlug] || post.category);
      const description = escapeHtml(post.description);
      return `
        <article class="group relative flex flex-col border-t border-line pt-4">
          <div class="flex flex-1 flex-col">
            <div class="meta"><span class="cat" data-cat="${catSlug}">${category}</span></div>
            <h2 class="mt-2 font-display text-[1.1875rem] font-bold leading-snug tracking-[-0.015em] text-ink">
              <a href="/${slug}/" class="stretched hover-title">${title}</a>
            </h2>
            ${description ? `<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-3">${description}</p>` : ''}
            <p class="meta mt-auto pt-3"><time datetime="${escapeHtml(post.pubDate)}">${date}</time></p>
          </div>
        </article>`;
    }

    let activeCategory = 'all';

    async function doGlobalFilter() {
      const query = searchInput.value.toLowerCase().trim();

      if (query === '' && activeCategory === 'all') {
        grid.innerHTML = originalHtml;
        if (countText) countText.textContent = originalCountText;
        emptyState?.classList.add('hidden');
        pagination?.classList.remove('hidden');
        return;
      }

      if (!window.__searchIndex) {
        try {
          const res = await fetch('/search-index.json');
          window.__searchIndex = await res.json();
        } catch (err) {
          console.error('Failed to load search index', err);
          return;
        }
      }

      const matches = (window.__searchIndex || []).filter((post) => {
        if (activeCategory !== 'all' && slugify(post.category) !== activeCategory) return false;
        if (query !== '') {
          return (
            post.title.toLowerCase().includes(query) ||
            post.description.toLowerCase().includes(query) ||
            post.category.toLowerCase().includes(query)
          );
        }
        return true;
      });

      pagination?.classList.add('hidden');
      if (matches.length === 0) {
        grid.innerHTML = '';
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
        // Limita a renderização para manter a página leve; o refinamento da busca reduz a lista.
        grid.innerHTML = matches.slice(0, 60).map(renderCard).join('');
      }

      if (countText) {
        countText.textContent = `${matches.length} ${matches.length === 1 ? 'artigo encontrado' : 'artigos encontrados'} em todo o blog.`;
      }
    }

    document.querySelectorAll('.category-pill').forEach((pill) => {
      pill.addEventListener('click', async (event) => {
        const target = event.currentTarget;
        activeCategory = target.getAttribute('data-category');
        document.querySelectorAll('.category-pill').forEach((other) => {
          other.setAttribute('aria-pressed', String(other === target));
        });
        await doGlobalFilter();
      });
    });

    searchInput.addEventListener('input', doGlobalFilter);

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('search') === 'focus') searchInput.focus();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupArchiveSearch, { once: true });
  } else {
    setupArchiveSearch();
  }

  document.addEventListener('astro:page-load', setupArchiveSearch);
</script>
