---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
import Hero from '../components/Hero.astro';
import CategoryBand from '../components/CategoryBand.astro';
import Picks from '../components/Picks.astro';
import Feed from '../components/Feed.astro';
import Sidebar from '../components/Sidebar.astro';
import MuralJobs from '../components/MuralJobs.astro';
---

<Layout title="Doug Design | Desenvolvimento, Web Design, IA e Games" description="Blog brasileiro com guias práticos sobre web design, IA, programação, tecnologia e games.">
  <main id="main">
    <h1 class="sr-only">Doug Design: guias práticos de web design, IA, programação, tecnologia e games</h1>

    <Hero />

    <!-- Anúncio 1: logo após os destaques, sem empurrar a manchete para baixo da dobra -->
    <div class="wrap mt-10 sm:mt-14">
      <AdSense slot="6543940190" format="auto" fullWidthResponsive={true} size="leaderboard" simulatedText="Google AdSense - Banner Responsivo" />
    </div>

    <CategoryBand />

    <Picks />

    <section class="wrap mt-16 grid gap-12 sm:mt-24 lg:grid-cols-12 lg:gap-14" aria-label="Últimas publicações e barra lateral">
      <Feed />
      <Sidebar />
    </section>

    <MuralJobs />
  </main>
</Layout>
