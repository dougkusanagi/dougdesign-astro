---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LivePixWidget from '../components/LivePixWidget.astro';
---

<Layout title="Contato - Doug Design" description="Entre em contato com a equipe do Doug Design para parcerias, sugestões ou envio de vagas.">
  <main id="main">
    <PageHero
      eyebrow="Contato"
      title="Fale conosco"
      description="Tem uma sugestão, crítica ou quer divulgar uma vaga no mural? Se encontrou algum problema no novo layout, conte também: informe o endereço da página, o aparelho e o navegador."
    />

    <div class="wrap mt-10">
      <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-3">
        <div class="space-y-6 md:col-span-1">
          <div>
            <h2 class="eyebrow">E-mail direto</h2>
            <a href="mailto:contato@dougdesign.com.br" class="mt-2 inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-accent">
              <Icon name="mail" class="h-4 w-4" /> contato@dougdesign.com.br
            </a>
          </div>
          <div>
            <h2 class="eyebrow">Redes</h2>
            <a href="https://github.com/dougkusanagi" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-accent">
              <Icon name="github" class="h-4 w-4" /> GitHub
            </a>
          </div>
        </div>

        <div class="panel p-6 md:col-span-2 sm:p-8">
          <form id="contact-form" class="space-y-5">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-bold text-ink">Nome</label>
              <input type="text" id="name" name="name" required autocomplete="name" class="field" />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-bold text-ink">E-mail</label>
              <input type="email" id="email" name="email" required autocomplete="email" class="field" />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-bold text-ink">Mensagem</label>
              <textarea id="message" name="message" rows="5" required class="field"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full !min-h-12">Enviar mensagem</button>
          </form>

          <div id="success-message" class="hidden py-8 text-center" aria-live="polite">
            <div class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
              <Icon name="check" class="h-6 w-6" />
            </div>
            <h2 class="font-display text-lg font-extrabold text-ink">Cliente de e-mail aberto</h2>
            <p class="mt-1 text-sm text-ink-3">Revise a mensagem e clique em enviar no seu aplicativo de e-mail para concluir o contato.</p>
          </div>
        </div>
      </div>

      <LivePixWidget className="mx-auto mt-16 max-w-2xl" />
    </div>
  </main>
</Layout>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    const success = document.getElementById('success-message');
    if (!form || !success || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = `Contato Doug Design — ${String(data.get('name') || '').trim()}`;
      const body = [
        `Nome: ${String(data.get('name') || '').trim()}`,
        `E-mail para resposta: ${String(data.get('email') || '').trim()}`,
        '',
        String(data.get('message') || '').trim(),
      ].join('\\n');
      window.location.href = `mailto:contato@dougdesign.com.br?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      form.classList.add('hidden');
      success.classList.remove('hidden');
    });
  })();
</script>
