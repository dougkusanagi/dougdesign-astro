---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

// Load markdown files from the docs/components/ folder using Vite glob
const componentDocsGlob = import.meta.glob('../../../docs/components/*.md', { eager: true });

// Extract component details for list and search
const componentsList = Object.entries(componentDocsGlob).map(([filePath, doc]: [string, any]) => {
  const fileParts = filePath.split(/[/\\]/);
  const fileName = fileParts[fileParts.length - 1];
  const name = fileName.replace('.md', '');
  return {
    name,
    title: doc.frontmatter?.title || name,
    Content: doc.default
  };
});
---

<Layout title="Documentação de Componentes | Doug Design">
  <main id="main">
    <PageHero eyebrow="Design system" title="Documentação de componentes" description="Tokens, componentes e regras de uso do layout v2 (beta)." />

    <div class="wrap mt-10 lg:flex lg:gap-8">
      <!-- Sidebar Navigation -->
      <aside class="mb-8 flex-shrink-0 lg:mb-0 lg:w-64">
        <div class="panel sticky top-24 p-5">
          <h2 class="eyebrow mb-3">Componentes</h2>

          <div class="mb-4">
            <label for="component-search" class="sr-only">Filtrar componentes</label>
            <input type="text" id="component-search" placeholder="Filtrar…" class="field !py-2 !text-sm" />
          </div>

          <nav class="space-y-1" id="components-nav">
            {componentsList.map((comp, idx) => (
              <a
                href={`#${comp.name}`}
                data-name={comp.name.toLowerCase()}
                class={`block rounded-lg px-3 py-2 text-sm font-semibold ${idx === 0 ? 'bg-accent-soft text-accent-strong' : 'text-ink-2 hover:bg-surface-2'}`}
                onclick={`setActiveTab('${comp.name}')`}
              >
                {comp.name}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Content Area -->
      <section class="min-w-0 flex-1">
        <div class="panel p-6 sm:p-8">
          <h2 class="sr-only">Conteúdo</h2>

          {componentsList.map((comp, idx) => (
            <div id={`section-${comp.name}`} class={`component-section space-y-6 ${idx === 0 ? '' : 'hidden'}`}>
              <article class="prose max-w-none">
                <comp.Content />
              </article>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  // Simple client-side navigation and filtering
  const NAV_ACTIVE = 'block rounded-lg bg-accent-soft px-3 py-2 text-sm font-semibold text-accent-strong';
  const NAV_IDLE = 'block rounded-lg px-3 py-2 text-sm font-semibold text-ink-2 hover:bg-surface-2';
  function setActiveTab(compName) {
    // Hide all sections
    const sections = document.querySelectorAll('.component-section');
    sections.forEach(sec => sec.classList.add('hidden'));

    // Show selected section
    const targetSection = document.getElementById(`section-${compName}`);
    if (targetSection) {
      targetSection.classList.remove('hidden');
    }

    // Update active nav link style
    const navLinks = document.querySelectorAll('#components-nav a');
    navLinks.forEach(link => {
      if (link.getAttribute('href') === `#${compName}`) {
        link.className = NAV_ACTIVE;
      } else {
        link.className = NAV_IDLE;
      }
    });
  }

  // Handle URL hash on initial load
  window.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.substring(1);
    if (hash) {
      setActiveTab(hash);
    }

    // Search filter execution
    const searchInput = document.getElementById('component-search');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const links = document.querySelectorAll('#components-nav a');
        links.forEach(link => {
          const name = link.getAttribute('data-name');
          if (name.includes(query)) {
            link.classList.remove('hidden');
          } else {
            link.classList.add('hidden');
          }
        });
      });
    }
  });
</script>
